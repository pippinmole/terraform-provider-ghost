# Copy to terraform.tfvars (gitignored, never commit it) and fill in your own values:
#   cp playground/terraform.tfvars.example playground/terraform.tfvars

# Your Ghost personal access token.
ghost_token = "ghost_pat_..."

# Optional: point at a different Ghost instance.
# ghost_base_url = "https://api.ghost.procrastinator.fyi"

# Optional: prefix for every repository the playground creates.
# name_prefix = "playground"

# Optional: an organization you administer, to also create an org-owned repository.
# organization = "my-org"

# Optional: the ID of a team in that organization, to add as a ruleset bypass
# actor, to look up with the ghost_team data source and to give access to the
# organization repositories with ghost_team_repository. Find it in the
# organization_teams output after an apply with only organization set.
# organization_team_id = "..."

# Optional: the username of another Ghost user to invite to the repositories
# with ghost_repository_collaborator. The invitation stays pending unless they
# accept it, and destroy withdraws it.
# collaborator = "octocat"

# Optional: usernames of members of that organization to add to that team with
# ghost_team_membership, one as a maintainer (by team ID) and one as a member
# (by team slug). Only organization members can join its teams, and they can't
# be invited with a token. Destroy takes them out of the team again.
# team_maintainer = "alice"
# team_member     = "bob"
